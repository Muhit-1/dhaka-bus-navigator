{
  "name": "dhaka-city-bus-navigator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "server": "node --env-file=server/.env server/index.js",
    "server:dev": "node --watch --env-file=server/.env server/index.js",
    "db:seed": "node --env-file=server/.env server/seed.js",
    "dev:all": "concurrently \"npm:server:dev\" \"npm:dev\""
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "framer-motion": "^10.16.16",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "mysql2": "^3.11.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.0"
  }
